CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=400
CONFIG_PACKAGE_kmod-rtc-ds1307=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-unbound=y
CONFIG_PACKAGE_unbound-checkconf=y
CONFIG_PACKAGE_chrony-nts=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_owut=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
