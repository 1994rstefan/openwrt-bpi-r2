# Update this digest only through a reviewed change. Apt/toolchain versions are
# recorded too; a pinned base alone does not promise bit-reproducible builds.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
ARG BUILD_UID=1001
ARG BUILD_GID=1001
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
    bash bison build-essential ca-certificates clang curl file flex g++-multilib \
    gawk gcc-multilib gettext git libelf-dev libncurses-dev libssl-dev python3 \
    python3-docutils python3-pyelftools python3-setuptools rsync subversion swig \
    time unzip wget xsltproc zlib1g-dev zstd \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid "$BUILD_GID" builder \
    && useradd --create-home --uid "$BUILD_UID" --gid "$BUILD_GID" builder
USER builder
WORKDIR /build/openwrt
